JWT_ISSUER=eshop.identity
JWT_AUDIENCE=eshop.apis
JWT_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=CHANGE_ME
AUTH_ADMIN_FULL_NAME=Administrador
AUTH_ADMIN_FORCE_PASSWORD_RESET=false

MONGODB_CONNECTION_STRING=CHANGE_ME_WITH_MONGODB_ATLAS_CONNECTION_STRING
MONGODB_DATABASE_NAME=EshopOrders
MONGODB_ORDERS_COLLECTION=orders
ORDERS_TAX_RATE=0.18

MongoDb__ConnectionString=CHANGE_ME_WITH_MONGODB_ATLAS_CONNECTION_STRING
MongoDb__DatabaseName=EshopOrders
MongoDb__OrdersCollection=orders
Orders__TaxRate=0.18

NETLIFY_ORIGIN=https://your-site.netlify.app

# Azure Container Apps production reference values. Do not put real secrets here.
PRODUCTION_FRONTEND_ORIGIN=https://eshop-services.netlify.app
PRODUCTION_JWT_ISSUER=eshop-identity-production
PRODUCTION_JWT_AUDIENCE=eshop-apis-production
